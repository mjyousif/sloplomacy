# Supabase Configuration for Diplomacy 1901
# Copy this file to frontend/.env and fill in your Supabase project credentials
# from https://supabase.com/dashboard/project/_/settings/api

# Client-Side Authentication (Baked into Vite build)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Server-Side Backend Persistence (Used by FastAPI container for game state tracking)
# Required in production: provide the service_role key to bypass locked-down RLS policies.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server-Side Admin JWT Authorization
# If using HS256: set your project's JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# If using ES256 / ECC (P-256): optional PEM public key (otherwise fetched automatically from Supabase JWKS)
# SUPABASE_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
